{
  "name": "dynamicformdjx-vue2",
  "version": "0.0.1",
  "author": "xczcdjx",
  "description": "Dynamic form components for Vue 2",
  "license": "MIT",
  "main": "dist/index.common.js",
  "unpkg": "dist/index.umd.min.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "serve": "vue-cli-service serve",
    "build-p": "vue-cli-service build --target lib --name index --dest dist src/index.ts",
    "build:dts": "vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist/types && cpx src/types/dyForm.d.ts dist/types/types",
    "lint": "vue-cli-service lint",
    "pub": "npm run build && npm publish --access public"
  },
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.less"
  ],
  "keywords": [
    "vue",
    "vue2",
    "dynamicform",
    "form",
    "component-library"
  ],
  "dependencies": {
    "core-js": "^3.8.3"
  },
  "peerDependencies": {

  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "@vue/babel-preset-jsx": "^1.4.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/eslint-config-typescript": "^9.1.0",
    "cpx": "^1.5.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "less": "^4.4.2",
    "less-loader": "^12.3.0",
    "typescript": "~4.5.5",
    "vue": "^2.6.14",
    "vue-class-component": "^7.2.3",
    "vue-property-decorator": "^9.1.2",
    "vue-template-compiler": "^2.6.14",
    "vue-tsc": "^1.8.27"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended",
      "@vue/typescript"
    ],
    "parserOptions": {
      "parser": "@typescript-eslint/parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
