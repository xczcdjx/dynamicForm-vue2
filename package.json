{
  "name": "dynamicformdjx-vue2",
  "version": "0.0.7",
  "author": "xczcdjx",
  "description": "Dynamic form components for Vue 2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xczcdjx/dynamicForm-vue2"
  },
  "homepage": "https://github.com/xczcdjx/dynamicForm-vue2#readme",
  "bugs": {
    "url": "https://github.com/xczcdjx/dynamicForm-vue2/issues"
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./elementUi": {
      "types": "./dist/elementUi/index.d.ts",
      "require": "./dist/elementUi/index.cjs",
      "default": "./dist/elementUi/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "elementUi.js",
    "elementUi.d.ts"
  ],
  "scripts": {
    "serve": "vue-cli-service serve",
    "build-v2": "vue-cli-service build --target lib --name index --dest dist src/index.ts",
    "build:elementUi": "vue-cli-service build --target lib --name index --dest dist/elementUi src/elementUi/index.ts",
    "build:dts": "vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist/types",
    "build:web-types": "vue-docgen-web-types --configFile web-types.config.js",
    "fix:web-types": "node fix-web-types.mjs",
    "gen:compat-entry": "node gen-compat-entry.mjs",
    "build:all": "npm run build-v2 && npm run build:dts && npm run build:web-types",
    "lint": "vue-cli-service lint",
    "pub": "npm run build && npm publish --access public",
    "clean": "rimraf dist",
    "build": "npm run clean && rollup -c rollup.config.mjs && npm run build:web-types && npm run gen:compat-entry"
  },
  "sideEffects": [
    "*.css",
    "*.less"
  ],
  "keywords": [
    "vue",
    "vue2",
    "dynamicform",
    "form",
    "component-library"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.12.16",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "@vue/babel-preset-jsx": "^1.4.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/eslint-config-typescript": "^9.1.0",
    "core-js": "^3.8.3",
    "element-ui": "^2.15.14",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "less": "^4.6.4",
    "less-loader": "^12.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^2.80.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "rollup-plugin-vue": "^5.1.9",
    "typescript": "~4.5.5",
    "vue": "^2.6.14",
    "vue-class-component": "^7.2.3",
    "vue-docgen-web-types": "^0.1.8",
    "vue-property-decorator": "^9.1.2",
    "vue-template-compiler": "^2.6.14",
    "vue-tsc": "^1.8.27"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended",
      "@vue/typescript"
    ],
    "parserOptions": {
      "parser": "@typescript-eslint/parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "dependencies": {
    "@babel/runtime": "^7.29.2"
  }
}
